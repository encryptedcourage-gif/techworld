# ---- Claude Marketplace settings ----
# Copy this file to ".env" and edit the values. Everything has a safe default
# for local testing, but you MUST change ADMIN_PASSWORD and JWT_SECRET before
# putting the site online.

# The CLIENT site port (the link you share with customers).
PORT=8080
# The ADMIN site port (a separate link / tunnel you keep private).
ADMIN_PORT=8787

# Where the SQLite database file lives. This file holds every member login and
# every chat message, so keeping it on disk is what makes them survive restarts
# and the laptop going to sleep. Keep the default unless you know why not.
DB_PATH=data/marketplace.db

# The first admin account. On first launch the server creates this account so
# you can sign in and start adding members and plans. Change the password!
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Admin

# Secret used to sign login tokens. Use a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret

# Optional: the brand/title shown at the top of the public site.
SITE_NAME=Claude Marketplace
