# ---- Copy this file to ".env" and fill in real values ----

# Your Anthropic API key (get it at https://console.anthropic.com -> API Keys).
# THIS IS A COST TO YOU: every message a customer sends spends a little of this.
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_API_KEY_HERE

# Which Claude model to use. Cheaper model = bigger profit margin, slightly lower quality.
#   claude-sonnet-5-5  -> great balance (recommended default)
#   claude-haiku-4-5-20251001 -> cheapest, fast, good for simple tasks
#   claude-opus-5-5    -> most capable, most expensive
CLAUDE_MODEL=claude-sonnet-5-5

# A long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Stripe (how customers pay YOU) ----
# From https://dashboard.stripe.com/apikeys  (use test keys while building).
# Your secret key starts with "sk_test_" (test) or "sk_live_" (live).
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE
# Create a recurring "Price" in Stripe (e.g. $10/month) and paste its id
# (it starts with "price_").
STRIPE_PRICE_ID=PASTE_YOUR_STRIPE_PRICE_ID_HERE
# From the Stripe webhook you create (it starts with "whsec_"). See README.
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET_HERE

# The public URL of your site, used for Stripe redirect links.
# Locally this is http://localhost:8080 ; in production your real domain.
PUBLIC_URL=http://localhost:8080

# ---- Usage limits (protect your bill) ----
# Free users get this many messages per month before they must subscribe.
FREE_MONTHLY_LIMIT=5
# Paying subscribers get this many messages per month.
PRO_MONTHLY_LIMIT=1000

# Port the server listens on.
PORT=8080
