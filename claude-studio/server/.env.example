# ---- Copy this file to ".env" and fill in real values ----

# Which AI powers the site, per plan. Valid values: gemini | groq | anthropic
# AI_PROVIDER      -> what FREE users get (default for everyone).
# PAID_AI_PROVIDER -> what PAYING subscribers get (defaults to AI_PROVIDER).
# Example: free users on Gemini, paying customers upgraded to Groq:
#   AI_PROVIDER=gemini
#   PAID_AI_PROVIDER=groq
AI_PROVIDER=gemini
PAID_AI_PROVIDER=groq

# ---- Google Gemini (free tier, no credit card) ----
# Get a free key at https://aistudio.google.com -> "Get API key".
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
# Model to use. gemini-2.0-flash is fast and free-tier friendly.
GEMINI_MODEL=gemini-2.0-flash

# ---- Groq (free tier, fast open models) ----
# Get a free key at https://console.groq.com -> API Keys.
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Anthropic Claude (optional, paid) ----
# Only needed if you set a provider above to "anthropic".
# Paid key from https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# A long random secret used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Stripe (how customers pay YOU) ----
# From https://dashboard.stripe.com/apikeys  (use test keys while building).
# Your secret key starts with "sk_test_" (test) or "sk_live_" (live).
STRIPE_SECRET_KEY=PASTE_YOUR_STRIPE_SECRET_KEY_HERE
# From the Stripe webhook you create (it starts with "whsec_"). See README.
STRIPE_WEBHOOK_SECRET=PASTE_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET_HERE
# Create TWO recurring Prices in Stripe and paste their ids (start with "price_"):
#   Basic = $10/month  ->  STRIPE_PRICE_BASIC
#   Pro   = $20/month  ->  STRIPE_PRICE_PRO
STRIPE_PRICE_BASIC=PASTE_YOUR_10_DOLLAR_PRICE_ID_HERE
STRIPE_PRICE_PRO=PASTE_YOUR_20_DOLLAR_PRICE_ID_HERE

# The public URL of your site, used for Stripe redirect links.
# Locally this is http://localhost:8080 ; in production your real domain.
PUBLIC_URL=http://localhost:8080

# ---- Free trial + usage limits (protect your bill / free quota) ----
# New users get full access for this many days, then must upgrade.
FREE_TRIAL_DAYS=1
# Safety cap on messages during the free trial.
FREE_MONTHLY_LIMIT=25
# Monthly message caps per paid tier.
BASIC_MONTHLY_LIMIT=300
PRO_MONTHLY_LIMIT=2000

# Port the server listens on.
PORT=8080
